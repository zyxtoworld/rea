    "docs:prepare": "node scripts/generate-package-metadata.mjs && turbo run artifacts:product-catalog artifacts:managed-evidence artifacts:error-schema",
    "verify:web:qlog": "node scripts/run-script.mjs build:cached && node scripts/verify-qlog-captures.mjs",
    "licenses:generate": "node scripts/generate-third-party-inventory.mjs",
    "licenses:check": "node scripts/generate-third-party-inventory.mjs --check"
  },
